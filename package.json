{
  "name": "aquarismo-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:prod": "ng build --configuration=production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --runInBand --coverage",
    "lint": "ng lint",
    "serve:ssr": "node dist/aquarismo-app/server/server.mjs",
    "serve:ssr:aquarismo-app": "node dist/aquarismo-app/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "express": "^5.0.0",
    "keycloak-js": "^26.2.4",
    "rxjs": "~7.8.0",
    "swiper": "^12.1.3",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@ngneat/spectator": "^19.6.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "angular-eslint": "22.5.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^17.0.2",
    "ng-mocks": "^14.15.2",
    "prettier": "^3.8.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "piscina": "^5.3.2",
    "js-yaml": "^4.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.0": true,
    "esbuild@0.27.2": true,
    "lmdb@3.5.6": true,
    "lmdb@3.4.2": true,
    "msgpackr-extract@3.0.4": true,
    "msgpackr-extract@3.0.3": true,
    "unrs-resolver@1.12.2": true
  }
}
